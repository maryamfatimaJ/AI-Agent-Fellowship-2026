# Copy this file to .env and fill in real values. Never commit .env itself.

# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GENERATION_MODEL=gemini-2.5-flash-lite

# Any random long string works — used to sign Flask session cookies
SECRET_KEY=6fd4c1c7c413fd38ff6891b72dfea2e7172afecf9fa899be12b6cada44b1ff0b

# Database (SQLite by default; swap for a Postgres/Supabase URL if needed)
DATABASE_URL=sqlite:///productivity_agent.db

# Agent execution limits
MAX_AGENT_STEPS=8
MAX_TOOL_RETRIES=2
TOOL_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
