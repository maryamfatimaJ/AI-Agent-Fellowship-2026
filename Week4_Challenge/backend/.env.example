# ============================================================
# Evident Backend — Environment Configuration
# Copy this file to `.env` and fill in real values.
# ============================================================

# --- LLM Provider -------------------------------------------------
# One of: openai | gemini
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-1.5-pro

# Shared model behavior
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- Retry / Resilience --------------------------------------------
LLM_MAX_RETRIES=3
TOOL_MAX_RETRIES=2
TOOL_TIMEOUT_SECONDS=20

# --- Workflow behavior ----------------------------------------------
MAX_REVISION_CYCLES=2
MAX_CLARIFICATION_ROUNDS=2
ENABLE_BONUS_AGENTS=true

# --- Search tool ------------------------------------------------------
# Optional. If unset, falls back to DuckDuckGo HTML scraping (no key required).
TAVILY_API_KEY=

# --- App -----------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs
REPORTS_DIR=reports

# CORS: comma separated list of allowed origins for the Evident frontend
CORS_ALLOW_ORIGINS=http://localhost:5173
