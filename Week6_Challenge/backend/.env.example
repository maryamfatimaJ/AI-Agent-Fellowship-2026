# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Database ---
# SQLite for local dev (default). Swap to Postgres/Supabase by changing this URL only,
# e.g. postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM providers ---
# LLM_PROVIDER selects the default for chat + embeddings + memory extraction.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG / documents ---
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=20971520
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MIN_SCORE=0.65

# --- Memory / chat ---
MEMORY_CONTEXT_LIMIT=10
CONVERSATION_HISTORY_LIMIT=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
